# Server
PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/companionai?retryWrites=true&w=majority
MONGO_TLS=true
MONGO_TLS_VALIDATE=true

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SAMESITE=none
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# CORS/Origins (comma-separated list)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com
CLIENT_ORIGIN=https://app.yourdomain.com
SERVER_ORIGIN=https://api.yourdomain.com

# Redis (required in production for sessions, quotas, and rate limits)
REDIS_URL=rediss://:password@redis.example.com:6380/0
REDIS_CONNECT_TIMEOUT_MS=15000
REDIS_RETRY_BASE_MS=500
REDIS_RETRY_MAX_MS=30000

# Email (Brevo HTTPS API)
# Brevo transactional email API (HTTPS; no SMTP connection required)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=companionai.email@gmail.com
BREVO_SENDER_NAME=CompanionAI
REMINDER_DELIVERY_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=000000000
CLOUDINARY_API_SECRET=your_cloudinary_secret

# CAPTCHA (Cloudflare Turnstile or Google reCAPTCHA)
# Enable only in production when you wire the widget on the client
CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=your_turnstile_or_recaptcha_secret
CAPTCHA_LOGIN_ENABLED=true
CAPTCHA_REGISTER_ENABLED=true

# Judge0 (code execution)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com/submissions?base64_encoded=false&wait=true
JUDGE0_KEY=your_rapidapi_key
JUDGE0_HOST=judge0-ce.p.rapidapi.com
ALLOWED_JUDGE0_HOSTS=judge0-ce.p.rapidapi.com
JUDGE0_TIMEOUT_MS=15000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Metrics
METRICS_TOKEN=change_me_for_prom_scrape
AUDIT_TTL_SECONDS=7776000
LOG_LEVEL=info
GRAFANA_INSTANCE_ID=
GRAFANA_API_KEY=
GRAFANA_OTLP_URL=https://otlp-gateway-prod-ap-south-0.grafana.net/otlp/v1/metrics
OTEL_SERVICE_NAME=companionai-server
OTLP_PUSH_INTERVAL_MS=30000

# API rate limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=30
STT_RATE_LIMIT_MAX=60
CODE_RATE_LIMIT_MAX=20

# Quotas (per-user)
QUOTA_RUN_CODE_PER_HOUR=120
QUOTA_STT_PER_HOUR=120
QUOTA_INTERVIEW_CREATE_PER_HOUR=30
QUOTA_JOB_PREPARE_PER_HOUR=60
QUOTA_JOB_BULK_FEEDBACK_PER_HOUR=60

# Product plans / billing readiness
FREE_INTERVIEWS_PER_MONTH=3
FREE_RESUME_REVIEWS_PER_MONTH=3
PRO_INTERVIEWS_PER_MONTH=100
PRO_RESUME_REVIEWS_PER_MONTH=100
# Required before billingAvailable becomes true. Checkout/webhook adapter can map provider status to User plan fields.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_your_recurring_pro_price

# Antivirus (optional, enable in prod)
ENABLE_AV_SCAN=true
AV_SCAN_URL=https://scanner.internal/scan

# CSP allowlists (comma-separated)
CSP_CONNECT_SRC=https://api.openai.com,https://judge0-ce.p.rapidapi.com
CSP_IMG_SRC=https://res.cloudinary.com
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=

# Feature flags
ENABLE_STT=true
ENABLE_CODE_EXEC=true
ORIGIN_CHECK_ENFORCE=true
MONGO_REQUIRE_TRANSACTIONS=true

# Sentry (optional but recommended)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
WHISPER_MODEL_NAME=whisper-1
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# Web grounding (Tavily)
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=8000

# Preview timeouts
RESUME_PREVIEW_TIMEOUT_MS=10000

# BullMQ / Redis tuning
WORKER_CONCURRENCY=2
QUEUE_JOB_TIMEOUT_MS=60000
MAX_RESUME_BYTES=5242880

# Admin seed script (optional)
ADMIN_EMAIL=
ADMIN_NAME=Admin
ADMIN_PASSWORD=
