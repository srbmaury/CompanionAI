# Server
PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/companionai?retryWrites=true&w=majority
MONGO_TLS=true
MONGO_TLS_VALIDATE=true

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SAMESITE=none
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
MAX_SESSIONS_PER_USER=1

# CSRF
CSRF_SAMESITE=none
CSRF_COOKIE_DOMAIN=.yourdomain.com

# CORS/Origins (comma-separated list)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com
CLIENT_ORIGIN=https://app.yourdomain.com
SERVER_ORIGIN=https://api.yourdomain.com

# Redis (required in production for sessions, quotas, and rate limits)
REDIS_URL=rediss://:password@redis.example.com:6380/0
REDIS_CONNECT_TIMEOUT_MS=15000
REDIS_RETRY_BASE_MS=500
REDIS_RETRY_MAX_MS=30000

# Email (SMTP)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_FROM="CompanionAI <no-reply@yourdomain.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=000000000
CLOUDINARY_API_SECRET=your_cloudinary_secret

# CAPTCHA (Cloudflare Turnstile or Google reCAPTCHA)
# Enable only in production when you wire the widget on the client
CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=your_turnstile_or_recaptcha_secret
CAPTCHA_LOGIN_ENABLED=false
CAPTCHA_REGISTER_ENABLED=false

# Judge0 (code execution)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com/submissions?base64_encoded=false&wait=true
JUDGE0_KEY=your_rapidapi_key
JUDGE0_HOST=judge0-ce.p.rapidapi.com
ALLOWED_JUDGE0_HOSTS=judge0-ce.p.rapidapi.com
JUDGE0_TIMEOUT_MS=15000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Metrics
METRICS_TOKEN=change_me_for_prom_scrape

# API rate limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Quotas (per-user)
QUOTA_RUN_CODE_PER_HOUR=120
QUOTA_STT_PER_HOUR=120
QUOTA_INTERVIEW_CREATE_PER_HOUR=30
QUOTA_JOB_PREPARE_PER_HOUR=60
QUOTA_JOB_BULK_FEEDBACK_PER_HOUR=60

# Antivirus (optional, enable in prod)
ENABLE_AV_SCAN=true
AV_SCAN_URL=https://scanner.internal/scan

# CSP allowlists (comma-separated)
CSP_CONNECT_SRC=https://api.openai.com,https://judge0-ce.p.rapidapi.com
CSP_IMG_SRC=https://res.cloudinary.com
CSP_SCRIPT_SRC=
CSP_STYLE_SRC=

# Feature flags
ENABLE_STT=true
ENABLE_CODE_EXEC=true

# Sentry (optional but recommended)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
WHISPER_MODEL_NAME=whisper-1
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# Web grounding (Tavily)
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=8000

# Preview timeouts
RESUME_PREVIEW_TIMEOUT_MS=10000

# BullMQ / Redis tuning
REDIS_CONNECT_TIMEOUT_MS=15000
REDIS_RETRY_BASE_MS=500
REDIS_RETRY_MAX_MS=30000
WORKER_CONCURRENCY=2
QUEUE_JOB_TIMEOUT_MS=60000
MAX_RESUME_BYTES=5242880
